# Port de l'interface web
PORT=3030

# Facturo écoute seulement sur la machine locale par défaut. Un accès distant
# doit passer par le reverse proxy HTTPS décrit dans README.md.
HOST=127.0.0.1

# Mettre true pour interdire tout POST, PUT et DELETE, y compris via SSH.
FACTURO_READ_ONLY=false

# Répertoire d'archivage. Pour un Raspberry Pi, pointer vers un disque monté,
# par exemple : /mnt/facturo-archive
ARCHIVE_DIR=./storage/archive

# SMTP facultatif : l'envoi reste désactivé tant que ces valeurs sont absentes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# SUPER PDP — laisser vides tant que l'application OAuth n'est pas créée.
# Ces valeurs restent uniquement dans .env, jamais dans Git.
SUPER_PDP_API_BASE_URL=https://api.superpdp.tech/v1.beta
SUPER_PDP_TOKEN_URL=https://api.superpdp.tech/oauth2/token
SUPER_PDP_CLIENT_ID=
SUPER_PDP_CLIENT_SECRET=
