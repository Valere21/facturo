# Port de l'interface web
PORT=3030

# Répertoire d'archivage. Pour un Raspberry Pi, pointer vers un disque monté,
# par exemple : /mnt/facturo-archive
ARCHIVE_DIR=./storage/archive

# SMTP facultatif : l'envoi reste désactivé tant que ces valeurs sont absentes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
